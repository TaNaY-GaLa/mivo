// Mivo Environment Configuration — Assignment 2
// Copy this file to .env.local and fill in the actual values.
// NEVER commit .env.local or real credentials.

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/mivo"

# ─── Application URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Better Auth ───────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET="<your-better-auth-secret-min-32-chars>"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Resend Transactional Email ────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_<your-resend-api-key>"

# ─── Resend Webhook ────────────────────────────────────────────────────────────
# Get your webhook signing secret from https://resend.com/webhooks
RESEND_WEBHOOK_SECRET="whsec_<your-webhook-signing-secret>"

# ─── Email Sender ──────────────────────────────────────────────────────────────
# Must be a verified domain in your Resend account.
# For local dev without a verified domain, emails are logged to console.
RESEND_FROM_EMAIL="Mivo Orders <orders@yourdomain.com>"
